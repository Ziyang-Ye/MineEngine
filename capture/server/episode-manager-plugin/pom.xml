<?xml version="1.0" encoding="UTF-8"?>
<!-- Modified by Ziyang Ye for MineEngine, 2026 (from SolarisEngine 78f23e7); see capture/MODIFICATIONS.md -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>me.berrycraft</groupId>
    <artifactId>MirrorBot</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>
    <name>MirrorBot</name>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <!-- Compile for Java 17 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>

            <!-- Shade plugin: bundle dependencies if needed -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Copy built JAR into Paper server plugins folder -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-to-paper-plugins</id>
                        <phase>package</phase>
                        <configuration>
                            <target>
                                <property name="plugin.jar"
                                          value="${project.build.directory}/${project.build.finalName}.jar" />
                                <property name="plugin.filename"
                                          value="${project.build.finalName}.jar" />
                                <mkdir dir="${project.basedir}/../plugins" />
                                <delete file="${project.basedir}/../plugins/${plugin.filename}"
                                        quiet="true"
                                        failonerror="false" />
                                <copy file="${plugin.jar}"
                                      todir="${project.basedir}/../plugins"
                                      overwrite="true" />
                                <!-- Also refresh ../data*/plugins (per-instance server dirs).
                                     Linux/macOS: bash; Windows: PowerShell (bash may be missing or be the WSL stub). -->
                                <exec executable="bash" osfamily="unix" failonerror="false">
                                    <arg value="-lc" />
                                    <arg value="for d in ../data*/plugins; do if [ -d &quot;$d&quot; ]; then rm -f &quot;$d/${plugin.filename}&quot; &amp;&amp; cp '${plugin.jar}' &quot;$d/&quot;; fi; done" />
                                </exec>
                                <exec executable="powershell" osfamily="windows" failonerror="false">
                                    <arg value="-NoProfile" />
                                    <arg value="-NonInteractive" />
                                    <arg value="-Command" />
                                    <arg value="Get-ChildItem -Directory -Path '..' -Filter 'data*' -ErrorAction SilentlyContinue | ForEach-Object { $p = Join-Path $_.FullName 'plugins'; if (Test-Path -PathType Container $p) { Copy-Item -Force -LiteralPath '${plugin.jar}' -Destination $p } }" />
                                </exec>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
        <repository>
            <id>codemc</id>
            <url>https://repo.codemc.org/repository/maven-public/</url>
        </repository>

    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.skinsrestorer</groupId>
            <artifactId>skinsrestorer-api</artifactId>
            <version>15.8.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.dmulloy2</groupId>
            <artifactId>ProtocolLib</artifactId>
            <version>5.4.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
